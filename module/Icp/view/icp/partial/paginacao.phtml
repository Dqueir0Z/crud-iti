<?php
/**
 * Controle de paginação (usado via $this->paginationControl()).
 *
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var int $pageCount
 * @var int $current
 * @var int|null $previous
 * @var int|null $next
 * @var array<int, int> $pagesInRange
 * @var int $totalItemCount
 * @var int $firstItemNumber
 * @var int $lastItemNumber
 * @var string $rota
 * @var array<string, mixed> $query
 */

$link = fn (int $pagina): string => $this->url($rota, [], ['query' => ['pagina' => $pagina] + $query]);
?>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <div class="text-body-secondary small">
        <?php if ($totalItemCount > 0) : ?>
            Exibindo <?= $firstItemNumber ?>–<?= $lastItemNumber ?> de <?= number_format($totalItemCount, 0, ',', '.') ?>
        <?php endif; ?>
    </div>
    <?php if ($pageCount > 1) : ?>
        <nav aria-label="Paginação">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item<?= $previous === null ? ' disabled' : '' ?>">
                    <a class="page-link" href="<?= $previous === null ? '#' : $link($previous) ?>">Anterior</a>
                </li>
                <?php foreach ($pagesInRange as $pagina) : ?>
                    <li class="page-item<?= $pagina === $current ? ' active' : '' ?>">
                        <a class="page-link" href="<?= $link($pagina) ?>"
                           <?= $pagina === $current ? 'aria-current="page"' : '' ?>><?= $pagina ?></a>
                    </li>
                <?php endforeach; ?>
                <li class="page-item<?= $next === null ? ' disabled' : '' ?>">
                    <a class="page-link" href="<?= $next === null ? '#' : $link($next) ?>">Próxima</a>
                </li>
            </ul>
        </nav>
    <?php endif; ?>
</div>
