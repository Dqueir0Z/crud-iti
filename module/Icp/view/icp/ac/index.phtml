<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var Laminas\Paginator\Paginator<int, Icp\Entity\Ac> $acs
 * @var string $busca
 * @var Icp\Enum\Situacao|null $situacao
 * @var Application\Form\CsrfForm $formExclusao
 */

use Icp\Enum\Situacao;

$this->headTitle('Autoridades Certificadoras');
$query = array_filter(['busca' => $busca, 'situacao' => $situacao?->value], static fn ($v): bool => $v !== null && $v !== '');
?>
<div class="page-header">
    <div>
        <span class="sobretitulo">Cadastro</span>
        <h1>Autoridades Certificadoras</h1>
        <p class="subtitulo">AC de 1º nível credenciadas pela AC Raiz da ICP-Brasil.</p>
    </div>
    <a class="btn btn-primary" href="<?= $this->url('ac/create') ?>">Cadastrar AC</a>
</div>

<form method="get" action="<?= $this->url('ac') ?>" class="row g-2 filtros" role="search">
    <div class="col-md-6">
        <label for="busca" class="visually-hidden">Buscar por nome</label>
        <input type="search" id="busca" name="busca" class="form-control" placeholder="Buscar por nome…"
               value="<?= $this->escapeHtmlAttr($busca) ?>">
    </div>
    <div class="col-md-3">
        <label for="filtro-situacao" class="visually-hidden">Situação</label>
        <select id="filtro-situacao" name="situacao" class="form-select">
            <option value="">Todas as situações</option>
            <?php foreach (Situacao::cases() as $caso) : ?>
                <option value="<?= $caso->value ?>"<?= $situacao === $caso ? ' selected' : '' ?>><?= $this->escapeHtml($caso->rotulo()) ?></option>
            <?php endforeach; ?>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        <?php if ($query !== []) : ?>
            <a class="btn btn-link" href="<?= $this->url('ac') ?>">Limpar</a>
        <?php endif; ?>
    </div>
</form>

<?php if ($acs->getTotalItemCount() === 0) : ?>
    <div class="estado-vazio">
        <strong><?= $query !== [] ? 'Nenhuma AC encontrada com esses filtros.' : 'Nenhuma Autoridade Certificadora cadastrada.' ?></strong>
        <?= $query !== [] ? 'Ajuste ou limpe os filtros.' : 'Cadastre o primeiro registro ou importe o structure.json do ITI.' ?>
    </div>
<?php else : ?>
    <div class="table-responsive">
        <table class="table table-hover align-middle tabela-dados">
            <thead>
                <tr>
                    <th scope="col">Nome</th>
                    <th scope="col">Situação</th>
                    <th scope="col" class="text-end">AC N2</th>
                    <th scope="col" class="text-end"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($acs as $ac) : ?>
                    <tr>
                        <td>
                            <a href="<?= $this->url('ac/view', ['id' => $ac->getId()]) ?>"><?= $this->escapeHtml($ac->getNome()) ?></a>
                        </td>
                        <td><?= $this->partial('icp/partial/situacao', ['situacao' => $ac->getSituacao()]) ?></td>
                        <td class="text-end"><?= $ac->getAcN2s()->count() ?></td>
                        <td class="text-end acoes">
                            <a class="btn btn-sm btn-outline-secondary" href="<?= $this->url('ac/view', ['id' => $ac->getId()]) ?>">Visualizar</a>
                            <a class="btn btn-sm btn-outline-primary" href="<?= $this->url('ac/edit', ['id' => $ac->getId()]) ?>">Editar</a>
                            <?= $this->partial('icp/partial/botao-excluir', [
                                'url'          => $this->url('ac/delete', ['id' => $ac->getId()]),
                                'nome'         => $ac->getNome(),
                                'formExclusao' => $formExclusao,
                            ]) ?>
                            <?= $this->botaoQrCode('ac', (int) $ac->getId(), $ac->getNome()) ?>
                        </td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
<?php endif; ?>

<?= $this->paginationControl($acs, 'Sliding', 'icp/partial/paginacao', ['rota' => 'ac', 'query' => $query]) ?>
