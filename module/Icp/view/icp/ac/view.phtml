<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var Icp\Entity\Ac $ac
 * @var Application\Form\CsrfForm $formExclusao
 */

$this->headTitle($ac->getNome());
$acN2s = $ac->getAcN2s();
?>
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="<?= $this->url('ac') ?>">AC</a></li>
        <li class="breadcrumb-item active" aria-current="page"><?= $this->escapeHtml($ac->getNome()) ?></li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <span class="badge text-bg-light border mb-1">AC 1º nível</span>
        <h1 class="h3 mb-0"><?= $this->escapeHtml($ac->getNome()) ?></h1>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <?= $this->botaoQrCode('ac', (int) $ac->getId(), $ac->getNome(), 'btn btn-outline-dark') ?>
        <a class="btn btn-outline-primary" href="<?= $this->url('ac/edit', ['id' => $ac->getId()]) ?>">Editar</a>
        <?= $this->partial('icp/partial/botao-excluir', [
            'url'          => $this->url('ac/delete', ['id' => $ac->getId()]),
            'nome'         => $ac->getNome(),
            'formExclusao' => $formExclusao,
            'classe'       => 'btn btn-outline-danger',
        ]) ?>
    </div>
</div>

<dl class="row mb-4">
    <dt class="col-sm-3">Situação</dt>
    <dd class="col-sm-9"><?= $this->partial('icp/partial/situacao', ['situacao' => $ac->getSituacao()]) ?></dd>
    <dt class="col-sm-3">ID no ITI</dt>
    <dd class="col-sm-9"><?= $ac->getItiId() ?? '<span class="text-body-secondary">cadastro manual</span>' ?></dd>
    <dt class="col-sm-3">Atualizado em</dt>
    <dd class="col-sm-9"><?= $ac->getUpdatedAt()->format('d/m/Y H:i') ?></dd>
</dl>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">AC de 2º nível (<?= $acN2s->count() ?>)</h2>
    <a class="btn btn-sm btn-primary" href="<?= $this->url('ac-n2/create', [], ['query' => ['ac' => $ac->getId()]]) ?>">Cadastrar AC N2</a>
</div>

<?php if ($acN2s->count() === 0) : ?>
    <p class="text-body-secondary">Nenhuma AC N2 vinculada.</p>
<?php else : ?>
    <ul class="list-group">
        <?php foreach ($acN2s as $acN2) : ?>
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <a href="<?= $this->url('ac-n2/view', ['id' => $acN2->getId()]) ?>"><?= $this->escapeHtml($acN2->getNome()) ?></a>
                <span class="text-body-secondary small"><?= $acN2->getArs()->count() ?> AR</span>
            </li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>
