                                <th scope="col" class="text-end">Sem alteração</th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php foreach ($resultado->totais as $entidade => $totais) : ?>
                                <tr>
                                    <th scope="row"><?= $this->escapeHtml($entidade) ?></th>
                                    <td class="text-end"><?= number_format($totais['criados'], 0, ',', '.') ?></td>
                                    <td class="text-end"><?= number_format($totais['atualizados'], 0, ',', '.') ?></td>
