                                </tr>
                            <?php endforeach; ?>
                        </tbody>
                    </table>
                    <p class="mb-3">
                        Vínculos AR ↔ AC N2 criados: <strong><?= number_format($resultado->vinculosCriados, 0, ',', '.') ?></strong>
