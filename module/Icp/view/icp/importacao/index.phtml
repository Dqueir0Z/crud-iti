                    <?php if ($resultado->avisos !== []) : ?>
                        <h3 class="h6">Avisos</h3>
                        <ul class="small mb-3">
                            <?php foreach ($resultado->avisos as $aviso) : ?>
                                <li><?= $this->escapeHtml($aviso) ?></li>
                            <?php endforeach; ?>
