<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var Laminas\Paginator\Paginator<int, Icp\Entity\Ar> $ars
 * @var string $busca
 * @var int|null $acN2Id
 * @var Icp\Enum\Situacao|null $situacao
 * @var list<Icp\Entity\AcN2> $acN2s
 * @var Application\Form\CsrfForm $formExclusao
 */

use Icp\Enum\Situacao;

$this->headTitle('Autoridades de Registro');
$query = array_filter(['busca' => $busca, 'acN2' => $acN2Id, 'situacao' => $situacao?->value], static fn ($v): bool => $v !== null && $v !== '');

$grupos = [];
foreach ($acN2s as $acN2) {
    $grupos[$acN2->getAc()->getNome()][] = $acN2;
}
?>
<div class="page-header">
    <div>
        <span class="sobretitulo">Cadastro</span>
        <h1>Autoridades de Registro</h1>
        <p class="subtitulo">Cada AR pode estar vinculada a uma ou mais AC de 2º nível.</p>
    </div>
    <a class="btn btn-primary" href="<?= $this->url('ar/create') ?>">Cadastrar AR</a>
</div>

<form method="get" action="<?= $this->url('ar') ?>" class="row g-2 filtros" role="search">
    <div class="col-md-4">
        <label for="busca" class="visually-hidden">Buscar por nome</label>
        <input type="search" id="busca" name="busca" class="form-control" placeholder="Buscar por nome…"
               value="<?= $this->escapeHtmlAttr($busca) ?>">
    </div>
    <div class="col-md-3">
        <label for="filtro-acn2" class="visually-hidden">AC N2</label>
        <select id="filtro-acn2" name="acN2" class="form-select">
            <option value="">Todas as AC N2</option>
            <?php foreach ($grupos as $nomeAc => $itens) : ?>
                <optgroup label="<?= $this->escapeHtmlAttr($nomeAc) ?>">
                    <?php foreach ($itens as $acN2) : ?>
                        <option value="<?= $acN2->getId() ?>"<?= $acN2Id === $acN2->getId() ? ' selected' : '' ?>><?= $this->escapeHtml($acN2->getNome()) ?></option>
                    <?php endforeach; ?>
                </optgroup>
            <?php endforeach; ?>
        </select>
    </div>
    <div class="col-md-2">
        <label for="filtro-situacao" class="visually-hidden">Situação</label>
        <select id="filtro-situacao" name="situacao" class="form-select">
            <option value="">Todas as situações</option>
            <?php foreach (Situacao::cases() as $caso) : ?>
                <option value="<?= $caso->value ?>"<?= $situacao === $caso ? ' selected' : '' ?>><?= $this->escapeHtml($caso->rotulo()) ?></option>
            <?php endforeach; ?>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        <?php if ($query !== []) : ?>
            <a class="btn btn-link" href="<?= $this->url('ar') ?>">Limpar</a>
        <?php endif; ?>
    </div>
</form>

<?php if ($ars->getTotalItemCount() === 0) : ?>
    <div class="estado-vazio">
        <strong><?= $query !== [] ? 'Nenhuma AR encontrada com esses filtros.' : 'Nenhuma Autoridade de Registro cadastrada.' ?></strong>
        <?= $query !== [] ? 'Ajuste ou limpe os filtros.' : 'Cadastre o primeiro registro ou importe o structure.json do ITI.' ?>
    </div>
<?php else : ?>
    <div class="table-responsive">
        <table class="table table-hover align-middle tabela-dados">
            <thead>
                <tr>
                    <th scope="col">Nome</th>
                    <th scope="col" class="d-none d-md-table-cell">AC N2 vinculadas</th>
                    <th scope="col">Situação</th>
                    <th scope="col" class="text-end"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($ars as $ar) : ?>
                    <?php
                    $vinculos = $ar->getAcN2s()->toArray();
                    $visiveis = array_slice($vinculos, 0, 2);
                    $restantes = count($vinculos) - count($visiveis);
                    ?>
                    <tr>
                        <td>
                            <a href="<?= $this->url('ar/view', ['id' => $ar->getId()]) ?>"><?= $this->escapeHtml($ar->getNome()) ?></a>
                        </td>
                        <td class="small d-none d-md-table-cell">
                            <?= implode(', ', array_map(
                                fn ($acN2): string => '<a class="link-secondary" href="' . $this->url('ac-n2/view', ['id' => $acN2->getId()]) . '">'
                                    . $this->escapeHtml($acN2->getNome()) . '</a>',
                                $visiveis
                            )) ?>
                            <?php if ($restantes > 0) : ?>
                                <span class="text-body-secondary">e mais <?= $restantes ?></span>
                            <?php endif; ?>
                        </td>
                        <td><?= $this->partial('icp/partial/situacao', ['situacao' => $ar->getSituacao()]) ?></td>
                        <td class="text-end acoes">
                            <a class="btn btn-sm btn-outline-secondary" href="<?= $this->url('ar/view', ['id' => $ar->getId()]) ?>">Visualizar</a>
                            <a class="btn btn-sm btn-outline-primary" href="<?= $this->url('ar/edit', ['id' => $ar->getId()]) ?>">Editar</a>
                            <?= $this->partial('icp/partial/botao-excluir', [
                                'url'          => $this->url('ar/delete', ['id' => $ar->getId()]),
                                'nome'         => $ar->getNome(),
                                'formExclusao' => $formExclusao,
                            ]) ?>
                            <?= $this->botaoQrCode('ar', (int) $ar->getId(), $ar->getNome()) ?>
                        </td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
<?php endif; ?>

<?= $this->paginationControl($ars, 'Sliding', 'icp/partial/paginacao', ['rota' => 'ar', 'query' => $query]) ?>
