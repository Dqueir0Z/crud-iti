<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var int $totalAc
 * @var int $totalAcN2
 * @var int $totalAr
 * @var int $totalVinculos
 */

$this->headTitle('Início');

$numero = static fn (int $n): string => number_format($n, 0, ',', '.');

$indicadores = [
    ['titulo' => 'Autoridades Certificadoras', 'descricao' => 'AC de 1º nível', 'total' => $totalAc, 'rota' => 'ac'],
    ['titulo' => 'AC de 2º nível', 'descricao' => 'Subordinadas a uma AC', 'total' => $totalAcN2, 'rota' => 'ac-n2'],
    ['titulo' => 'Vínculos AR ↔ AC N2', 'descricao' => 'Uma AR pode atender várias AC N2', 'total' => $totalVinculos, 'rota' => 'ar'],
];
?>
<div class="page-header">
    <div>
        <span class="sobretitulo">Painel</span>
        <h1>Estrutura ICP-Brasil</h1>
        <p class="subtitulo">Autoridades Certificadoras e de Registro cadastradas no sistema.</p>
    </div>
</div>

<?php if ($totalAc === 0) : ?>
    <div class="estado-vazio mb-4">
        <strong>Nenhum registro cadastrado ainda.</strong>
        Importe o structure.json publicado pelo ITI para carregar a estrutura completa, ou cadastre manualmente.
        <div class="mt-3 d-flex justify-content-center gap-2">
            <a class="btn btn-primary" href="<?= $this->url('importacao') ?>">Importar structure.json</a>
            <a class="btn btn-outline-primary" href="<?= $this->url('ac/create') ?>">Cadastrar AC</a>
        </div>
    </div>
<?php endif; ?>

<section class="painel" aria-label="Totais">
    <div class="painel-destaque">
        <span class="rotulo">Autoridades de Registro</span>
        <div class="valor"><?= $numero($totalAr) ?></div>
        <p>
            Distribuídas em <?= $numero($totalAcN2) ?> AC de 2º nível, sob <?= $numero($totalAc) ?>
            Autoridades Certificadoras de 1º nível.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-claro" href="<?= $this->url('estrutura') ?>">Ver a estrutura</a>
            <a class="btn btn-contorno-claro" href="<?= $this->url('ar') ?>">Listar AR</a>
        </div>
        <?php if ($totalAr > 0) : ?>
            <dl class="painel-rodape">
                <div>
                    <dt>AC N2 por AR, em média</dt>
                    <dd><?= number_format($totalVinculos / $totalAr, 1, ',', '.') ?></dd>
                </div>
                <div>
                    <dt>AR por AC N2, em média</dt>
                    <dd><?= $totalAcN2 > 0 ? number_format($totalVinculos / $totalAcN2, 1, ',', '.') : '0' ?></dd>
                </div>
            </dl>
        <?php endif; ?>
    </div>

    <div class="painel-lista">
        <?php foreach ($indicadores as $item) : ?>
            <a class="indicador" href="<?= $this->url($item['rota']) ?>">
                <span class="titulo"><?= $this->escapeHtml($item['titulo']) ?></span>
                <span class="descricao"><?= $this->escapeHtml($item['descricao']) ?></span>
                <span class="valor"><?= $numero($item['total']) ?></span>
            </a>
        <?php endforeach; ?>
        <a class="indicador" href="<?= $this->url('importacao') ?>">
            <span class="titulo">Atualizar a partir do ITI</span>
            <span class="descricao">Reenvie o structure.json; nada é duplicado</span>
            <span class="valor" aria-hidden="true">→</span>
        </a>
    </div>
</section>
