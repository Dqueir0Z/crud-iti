<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string|null $reason
 * @var bool|null $display_exceptions
 */

use Laminas\Mvc\Application;

$this->headTitle('Página não encontrada');

$motivos = [
    Application::ERROR_CONTROLLER_CANNOT_DISPATCH => 'O controller não conseguiu atender a requisição.',
    Application::ERROR_CONTROLLER_NOT_FOUND       => 'O controller da rota não existe.',
    Application::ERROR_CONTROLLER_INVALID         => 'O controller da rota não é válido.',
    Application::ERROR_ROUTER_NO_MATCH            => 'Nenhuma rota corresponde a este endereço.',
];
?>
<div class="pagina-erro">
    <div class="codigo">404</div>
    <h1 class="h3 mt-3">Página não encontrada</h1>
    <p class="text-body-secondary">O endereço acessado não existe ou o registro foi excluído.</p>

    <?php if (! empty($this->display_exceptions) && ! empty($this->reason) && isset($motivos[$this->reason])) : ?>
        <p class="small text-body-secondary"><?= $this->escapeHtml($motivos[$this->reason]) ?></p>
    <?php endif; ?>

    <a class="btn btn-primary mt-2" href="<?= $this->url('home') ?>">Voltar ao início</a>
</div>
