<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string|null $rotaAtual
 */

use Application\Form\CsrfForm;

$usuario   = $this->identity();
$rotaAtual = (string) ($rotaAtual ?? '');

$menu = [
    'estrutura'  => 'Estrutura',
    'ac'         => 'AC',
    'ac-n2'      => 'AC N2',
    'ar'         => 'AR',
    'importacao' => 'Importar JSON',
];

$flash = $this->flashMessenger();
$flash->setMessageOpenFormat('<div%s role="alert"><div>')
    ->setMessageSeparatorString('</div><div>')
    ->setMessageCloseString('</div></div>');
?>
<?= $this->doctype() ?>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8">
        <?php // Títulos podem conter nomes cadastrados: manter o escape automático ativo. ?>
        <?= $this->headTitle('CRUD ICP-Brasil')->setSeparator(' · ') ?>

        <?= $this->headMeta()
            ->appendName('viewport', 'width=device-width, initial-scale=1.0')
            ->appendHttpEquiv('X-UA-Compatible', 'IE=edge')
        ?>

        <?= $this->headLink([
                'rel' => 'shortcut icon',
                'type' => 'image/vnd.microsoft.icon',
                'href' => $this->basePath() . '/img/favicon.ico'
            ])
            ->prependStylesheet($this->basePath('css/style.css'))
            ->prependStylesheet($this->basePath('css/bootstrap.min.css')) ?>

        <?= $this->headScript() ?>
    </head>
    <body class="d-flex flex-column min-vh-100">
        <nav class="navbar navbar-expand-lg navbar-dark mb-4" role="navigation">
            <div class="container">
                <a class="navbar-brand fw-semibold" href="<?= $this->url('home') ?>">CRUD ICP-Brasil</a>
                <?php if ($usuario) : ?>
                    <button
                        class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menu"
                    >
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="menuPrincipal">
                        <ul class="navbar-nav me-auto">
                            <?php foreach ($menu as $rota => $rotulo) : ?>
                                <?php $ativo = $rotaAtual === $rota || str_starts_with($rotaAtual, $rota . '/'); ?>
                                <li class="nav-item">
                                    <a class="nav-link<?= $ativo ? ' active' : '' ?>"
                                       <?= $ativo ? 'aria-current="page"' : '' ?>
                                       href="<?= $this->url($rota) ?>"><?= $this->escapeHtml($rotulo) ?></a>
                                </li>
                            <?php endforeach; ?>
                        </ul>
                        <?php $logout = new CsrfForm('logout'); ?>
                        <form method="post" action="<?= $this->url('logout') ?>" class="d-flex align-items-center gap-2">
                            <span class="navbar-text text-light small"><?= $this->escapeHtml($usuario['email'] ?? '') ?></span>
                            <?= $this->formHidden($logout->get('csrf')) ?>
                            <button type="submit" class="btn btn-sm btn-outline-light">Sair</button>
                        </form>
                    </div>
                <?php endif; ?>
            </div>
        </nav>

        <main class="container flex-grow-1">
            <?= $flash->render('success', ['alert', 'alert-success']) ?>
            <?= $flash->render('error', ['alert', 'alert-danger']) ?>
            <?= $flash->render('warning', ['alert', 'alert-warning']) ?>
            <?= $flash->render('info', ['alert', 'alert-info']) ?>

            <?= $this->content ?>
        </main>

        <footer class="container py-4 mt-4 border-top text-body-secondary small">
            Desafio técnico PHP · dados de referência:
            <a href="https://estrutura.iti.gov.br/" target="_blank" rel="noopener">estrutura.iti.gov.br</a>
        </footer>

        <?php if ($usuario) : ?>
            <?= $this->partial('icp/partial/qrcode-modal') ?>
        <?php endif; ?>

        <?= $this->inlineScript()
            ->prependFile($this->basePath('js/app.js'))
            ->prependFile($this->basePath('js/bootstrap.min.js')) ?>
    </body>
</html>
