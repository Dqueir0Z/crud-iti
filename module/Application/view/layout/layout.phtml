<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string|null $rotaAtual
 */

use Application\Form\CsrfForm;

$usuario   = $this->identity();
$rotaAtual = (string) ($rotaAtual ?? '');

$menu = [
    'home'       => 'Início',
    'estrutura'  => 'Estrutura',
    'ac'         => 'AC',
    'ac-n2'      => 'AC N2',
    'ar'         => 'AR',
    'importacao' => 'Importar JSON',
];

$flash = $this->flashMessenger();
$flash->setMessageOpenFormat('<div%s role="alert"><div>')
    ->setMessageSeparatorString('</div><div>')
    ->setMessageCloseString('</div></div>');
?>
<?= $this->doctype() ?>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8">
        <?php // Títulos podem conter nomes cadastrados: manter o escape automático ativo. ?>
        <?= $this->headTitle('CRUD ICP-Brasil')->setSeparator(' · ') ?>

        <?= $this->headMeta()
            ->appendName('viewport', 'width=device-width, initial-scale=1.0')
            ->appendName('description', 'Gestão da estrutura de Autoridades Certificadoras e de Registro da ICP-Brasil.')
            ->appendName('theme-color', '#0b3550')
        ?>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap">

        <?= $this->headLink([
                'rel' => 'icon',
                'type' => 'image/svg+xml',
                'href' => $this->basePath('img/marca.svg'),
            ])
            ->prependStylesheet($this->basePath('css/style.css'))
            ->prependStylesheet($this->basePath('css/bootstrap.min.css')) ?>

        <?= $this->headScript() ?>
    </head>
    <body class="<?= $usuario ? 'autenticado' : 'publico' ?>">
        <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>

        <header class="topo">
            <nav class="navbar navbar-expand-lg" aria-label="Navegação principal">
                <div class="container">
                    <a class="marca" href="<?= $this->url('home') ?>">
                        <img src="<?= $this->basePath('img/marca.svg') ?>" alt="" width="28" height="28">
                        <span>Estrutura <strong>ICP-Brasil</strong></span>
                    </a>
                    <?php if ($usuario) : ?>
                        <button
                            class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#menuPrincipal"
                            aria-controls="menuPrincipal"
                            aria-expanded="false"
                            aria-label="Abrir menu"
                        >
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="menuPrincipal">
                            <ul class="navbar-nav me-auto menu">
                                <?php foreach ($menu as $rota => $rotulo) : ?>
                                    <?php
                                    $ativo = $rotaAtual === $rota
                                        || ($rota !== 'home' && str_starts_with($rotaAtual, $rota . '/'));
                                    ?>
                                    <li class="nav-item">
                                        <a class="nav-link<?= $ativo ? ' active' : '' ?>"
                                           <?= $ativo ? 'aria-current="page"' : '' ?>
                                           href="<?= $this->url($rota) ?>"><?= $this->escapeHtml($rotulo) ?></a>
                                    </li>
                                <?php endforeach; ?>
                            </ul>
                            <?php $logout = new CsrfForm('logout'); ?>
                            <form method="post" action="<?= $this->url('logout') ?>" class="usuario">
                                <span class="usuario-avatar" aria-hidden="true">
                                    <?= $this->escapeHtml(mb_strtoupper(mb_substr((string) ($usuario['nome'] ?? $usuario['email'] ?? '?'), 0, 1))) ?>
                                </span>
                                <span class="usuario-email"><?= $this->escapeHtml($usuario['email'] ?? '') ?></span>
                                <?= $this->formHidden($logout->get('csrf')) ?>
                                <button type="submit" class="btn btn-link btn-sm usuario-sair">Sair</button>
                            </form>
                        </div>
                    <?php endif; ?>
                </div>
            </nav>
        </header>

        <main id="conteudo" class="container conteudo" tabindex="-1">
            <div class="avisos">
                <?= $flash->render('success', ['alert', 'alert-success']) ?>
                <?= $flash->render('error', ['alert', 'alert-danger']) ?>
                <?= $flash->render('warning', ['alert', 'alert-warning']) ?>
                <?= $flash->render('info', ['alert', 'alert-info']) ?>
            </div>

            <?= $this->content ?>
        </main>

        <footer class="rodape">
            <div class="container">
                <span>Desafio técnico PHP · Laminas, Doctrine e MySQL</span>
                <span>Dados de referência:
                    <a href="https://estrutura.iti.gov.br/" target="_blank" rel="noopener">estrutura.iti.gov.br</a>
                </span>
            </div>
